# Copy to backend/.env. Relative paths, if used, are relative to the backend working directory.
# Defaults keep the database and originals in backend/data (ignored by Git).
# SYJ_DATA_DIR=D:/Desktop/chuanzhibei/shuyouyiju/backend/data
SYJ_COOKIE_SECURE=false
SYJ_SESSION_SECONDS=604800
SYJ_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173,http://127.0.0.1:8000,http://localhost:8000
SYJ_MAX_UPLOAD_BYTES=20971520
SYJ_MAX_ROWS=50000
SYJ_MAX_COLUMNS=200
SYJ_MAX_CELLS=1000000
SYJ_MAX_PROJECT_FILES=20
# Testing account flow: email verification and password reset are not implemented.
# There is no model key or mail credential required for this milestone.
