# Copy to backend/.env. Relative paths, if used, are relative to the backend working directory.
# Defaults keep the database and originals in backend/data (ignored by Git).
# SYJ_DATA_DIR=D:/Desktop/chuanzhibei/shuyouyiju/backend/data
SYJ_COOKIE_SECURE=false
SYJ_SESSION_SECONDS=604800
SYJ_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173,http://127.0.0.1:8000,http://localhost:8000
SYJ_MAX_UPLOAD_BYTES=20971520
SYJ_MAX_ROWS=50000
SYJ_MAX_COLUMNS=200
SYJ_MAX_CELLS=1000000
SYJ_MAX_PROJECT_FILES=20
# Testing account flow: email verification and password reset are not implemented.
# Manual calculations work without a model key. AI stays explicitly unavailable until configured.
# Server-only Alibaba Bailian model API, NOT Coding Plan / Token Plan coding subscription.
SYJ_AI_API_KEY=
# Recommended: copy the exact workspace endpoint from the SAME REGION in the console.
# Beijing: https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# Legacy Beijing endpoint is also officially supported:
SYJ_AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SYJ_AI_REGION=cn-beijing
# qwen3.7-plus supports image_url + JSON with enable_thinking=false; check same-region API access/pricing.
SYJ_AI_MODEL=qwen3.7-plus
SYJ_AI_TIMEOUT_SECONDS=45
SYJ_AI_MAX_TOKENS=2500
SYJ_AI_MAX_REQUESTS=6
SYJ_AI_MAX_TOOL_CALLS=4

# Optional embedded Chinese TrueType font for PDF. Empty uses Windows SimSun.
# SYJ_PDF_FONT_PATH=C:/Windows/Fonts/simsun.ttc
# Linux example: /usr/share/fonts/truetype/wqy/wqy-zenhei.ttc

# Separate image, pixel and total request limits; Base64 is not counted as text.
SYJ_IMAGE_MAX_BYTES=8388608
SYJ_IMAGE_MAX_PIXELS=12000000
SYJ_AI_MAX_REQUEST_BYTES=12582912
